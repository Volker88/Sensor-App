{
  "default-configuration": "Debug",
  "configurations": [
    { "name": "Debug", "file": { "anchor": "Configuration", "relative-path": "Debug.xcconfig" } },
    { "name": "Release", "file": { "anchor": "Configuration", "relative-path": "Release.xcconfig" } },
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
      "cs",
      "de",
      "es",
      "fr",
      "it",
      "ja",
      "ko",
      "pt-PT",
      "zh-Hans",
    ],
  },
  "packages": [
    {
      "kind": "remote",
      "repository": "https://github.com/twostraws/KickstartSDK",
      "version": {
        "up-to-next-major-version": "0.5.0",
      },
    },
  ],
  "files": [
    {
      "kind": "folder",
      "path": "Configuration",
      "target-membership": [
        "Sensor-App",
        "Sensor-App-Framework",
        "Sensor-App-Watch",
      ],
      "membership-exceptions": [
        {
          "target": "Sensor-App",
          "exclusions": [
            "Debug.xcconfig",
            "General.xcconfig",
            "Release.xcconfig",
            "Secret.xcconfig",
          ],
        }, {
          "target": "Sensor-App-Watch",
          "exclusions": [
            "Debug.xcconfig",
            "General.xcconfig",
            "Release.xcconfig",
            "Secret.xcconfig",
          ],
        }, {
          "target": "Sensor-App-Framework",
          "exclusions": [
            "Debug.xcconfig",
            "General.xcconfig",
            "Release.xcconfig",
            "Secret.xcconfig",
          ],
        },
      ],
    }, {
      "kind": "folder",
      "path": "Sensor-App",
      "target-membership": [
        "Sensor-App",
      ],
      "membership-exceptions": [
        {
          "target": "Sensor-App",
          "exclusions": [
            "Miscellaneous/Info.plist",
          ],
        }, {
          "target": "Sensor-App-Watch",
          "inclusions": [
            "Resources/AppIcon-V1.icon",
            "Resources/AppIcon-V2.icon",
            "Resources/AppIcon-V3.icon",
            "Resources/Assets.xcassets",
            "Resources/InfoPlist.xcstrings",
            "Resources/Localizable.xcstrings",
            "Resources/ReleaseNotes.xcstrings",
          ],
        }, {
          "target": "Sensor-App-Framework",
          "inclusions": [
            "Resources/InfoPlist.xcstrings",
            "Resources/Localizable.xcstrings",
            "Resources/ReleaseNotes.xcstrings",
          ],
        }, {
          "target": "Sensor-AppiOSUITests",
          "inclusions": [
            "Miscellaneous/Launch Screen.storyboard",
            "Miscellaneous/UIIdentifiers.swift",
          ],
        },
      ],
    }, {
      "kind": "folder",
      "path": "Sensor-App-WatchApp",
      "target-membership": [
        "Sensor-App-Watch",
      ],
      "membership-exceptions": [
        {
          "target": "Sensor-App-Watch",
          "exclusions": [
