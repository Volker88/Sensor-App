            "Miscellaneous/PushNotificationPayload.apns",
          ],
        }, {
          "target": "Sensor-AppwatchOSUITests",
          "inclusions": [
            "Miscellaneous/UIIdentifiers.swift",
          ],
        },
      ],
    }, {
      "kind": "folder",
      "path": "Sensor-App-Framework",
      "target-membership": [
