  "targets": [
    {
      "name": "Sensor-App",
      "id": "1527B01624C4AA240024DD78",
      "product": "Products/Sensor-App.app",
      "product-type": "application",
      "dependencies": [
        "Sensor-App-Watch",
        "Sensor-App-Framework",
      ],
      "build-phases": [
        {
          "kind": "script",
          "name": "SwiftLint",
          "log-environment-variables": true,
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": [
            "export PATH=\"$PATH:/opt/homebrew/bin\"",
            "if which swiftlint > /dev/null; then",
            "  swiftlint",
            "else",
            "  echo \"SwiftLint not installed, download from https://github.com/realm/SwiftLint\"",
            "fi",
            "",
          ],
        }, {
          "kind": "script",
          "name": "Bundle Identifier",
          "log-environment-variables": true,
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": "echo \"Active Bundle Identifier: $BUNDLE_IDENTIFIER\"\n",
        },
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Watch Content",
          "bundle-base-path": "build-products-directory",
          "relative-path": "$(CONTENTS_FOLDER_PATH)/Watch",
        }, {
          "kind": "copy",
          "name": "Embed Frameworks",
          "bundle-base-path": "frameworks-directory",
        },
      ],
      "package-product-members": [
        {
          "package": "KickstartSDK",
          "product-name": "KickstartExchange",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "CODE_SIGN_ENTITLEMENTS[config=Debug]": "$(SRCROOT)/Sensor-App/Miscellaneous/Entitlements/Sensor-App-dev.entitlements",
        "CODE_SIGN_ENTITLEMENTS[config=Release]": "$(SRCROOT)/Sensor-App/Miscellaneous/Entitlements/Sensor-App.entitlements",
        "CODE_SIGN_IDENTITY[config=Debug]": "Apple Development",
        "CODE_SIGN_STYLE": "Automatic",
        "DEAD_CODE_STRIPPING": "YES",
        "ENABLE_HARDENED_RUNTIME[config=Debug]": "YES",
        "ENABLE_PREVIEWS": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "$(SRCROOT)/Sensor-App/Miscellaneous/Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "Sensor-App",
        "INFOPLIST_KEY_ITSAppUsesNonExemptEncryption": "NO",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.productivity",
        "INFOPLIST_KEY_NSHumanReadableCopyright": "© 2026, Volker Schmitt",
        "INFOPLIST_KEY_NSLocationWhenInUseUsageDescription": "Location access is needed to display your current position, travel direction, and speed in real time",
        "INFOPLIST_KEY_NSMotionUsageDescription": "Motion sensor access is required to display real-time movement data",
        "INFOPLIST_KEY_UILaunchScreen_Generation": "YES",
        "INFOPLIST_KEY_UILaunchStoryboardName": "Launch Screen",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations": "UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight UIInterfaceOrientationPortrait",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad": "UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "PROVISIONING_PROFILE_SPECIFIER[config=Debug]": "",
        "REGISTER_APP_GROUPS": "YES",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator",
        "SUPPORTS_MACCATALYST": "NO",
        "SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "TARGETED_DEVICE_FAMILY": "1,2",
      },
    }, {
      "name": "Sensor-App-Watch",
      "id": "1527B04624C4AA620024DD78",
      "product": "Products/Sensor-App-Watch.app",
      "product-type": "application",
      "dependencies": [
        "Sensor-App-Framework",
      ],
      "build-phases": [
        {
          "kind": "script",
          "name": "SwiftLint",
          "log-environment-variables": true,
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": [
            "export PATH=\"$PATH:/opt/homebrew/bin\"",
            "if which swiftlint > /dev/null; then",
            "  swiftlint",
            "else",
            "  echo \"SwiftLint not installed, download from https://github.com/realm/SwiftLint\"",
            "fi",
            "",
          ],
        }, {
          "kind": "script",
          "name": "Bundle Identifier",
          "log-environment-variables": true,
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": "echo \"Active Bundle Identifier: $BUNDLE_IDENTIFIER\"\n",
        },
        "resources",
        "compile-sources",
        "frameworks",
        {
          "kind": "copy",
          "name": "Embed Frameworks",
          "bundle-base-path": "frameworks-directory",
        },
      ],
      "build-settings": {
        "CODE_SIGN_ENTITLEMENTS[config=Debug]": "$(SRCROOT)/Sensor-App-WatchApp/Miscellaneous/Entitlements/watchOS-dev.entitlements",
        "CODE_SIGN_ENTITLEMENTS[config=Release]": "$(SRCROOT)/Sensor-App-WatchApp/Miscellaneous/Entitlements/watchOS.entitlements",
        "CODE_SIGN_IDENTITY": "Apple Development",
        "CODE_SIGN_STYLE": "Automatic",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "$(SRCROOT)/Sensor-App-WatchApp/Miscellaneous/Info.plist",
        "INFOPLIST_KEY_NSLocationWhenInUseUsageDescription": "Location access is needed to display your current position, travel direction, and speed in real time",
        "INFOPLIST_KEY_NSMotionUsageDescription": "Motion sensor access is required to display real-time movement data",
        "INFOPLIST_KEY_WKCompanionAppBundleIdentifier": "$(BUNDLE_IDENTIFIER)",
        "LD_RUNPATH_SEARCH_PATHS": [
          "@executable_path/Frameworks",
          "@executable_path/../../Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "${BUNDLE_IDENTIFIER}.watchkitapp",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "PROVISIONING_PROFILE_SPECIFIER[config=Debug]": "",
        "SDKROOT": "watchos",
        "SKIP_INSTALL": "YES",
        "TARGETED_DEVICE_FAMILY": "4",
      },
    }, {
      "name": "Sensor-App-Framework",
      "id": "1527B07824C4ACA20024DD78",
      "product": "Products/Sensor_App_Framework.framework",
      "product-type": "framework",
      "build-phases": [
        "headers",
        {
          "kind": "script",
          "name": "Swiftlint",
          "log-environment-variables": true,
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": [
            "export PATH=\"$PATH:/opt/homebrew/bin\"",
            "if which swiftlint > /dev/null; then",
            "  swiftlint",
            "else",
            "  echo \"SwiftLint not installed, download from https://github.com/realm/SwiftLint\"",
            "fi",
            "",
          ],
        },
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "CODE_SIGN_IDENTITY": "",
        "CODE_SIGN_STYLE": "Automatic",
        "DEAD_CODE_STRIPPING": "YES",
        "DYLIB_COMPATIBILITY_VERSION": "1",
        "DYLIB_CURRENT_VERSION": "1",
        "DYLIB_INSTALL_NAME_BASE": "@rpath",
        "ENABLE_MODULE_VERIFIER": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INSTALL_PATH": "$(LOCAL_LIBRARY_DIR)/Frameworks",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
          "@loader_path/Frameworks",
        ],
        "MODULE_VERIFIER_SUPPORTED_LANGUAGE_STANDARDS": "gnu11 gnu++14",
        "PRODUCT_BUNDLE_IDENTIFIER": "${BUNDLE_IDENTIFIER}.Framework",
        "PRODUCT_NAME": "$(TARGET_NAME:c99extidentifier)",
        "SDKROOT": "auto",
        "SKIP_INSTALL": "YES",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator watchos watchsimulator",
        "SUPPORTS_MACCATALYST": "NO",
        "SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "TARGETED_DEVICE_FAMILY": "1,2,4",
        "VERSIONING_SYSTEM": "apple-generic",
        "VERSION_INFO_PREFIX": "",
      },
    }, {
      "name": "Sensor-AppiOSUnitTests",
      "id": "1527B02724C4AA240024DD78",
      "product": "Products/Sensor-AppiOSUnitTests.xctest",
      "product-type": "bundle.unit-test",
      "test-host-target": "Sensor-App",
      "dependencies": [
        "Sensor-App",
      ],
      "build-phases": [
        {
          "kind": "script",
          "name": "Swiftlint",
          "log-environment-variables": true,
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": [
            "export PATH=\"$PATH:/opt/homebrew/bin\"",
            "if which swiftlint > /dev/null; then",
            "  swiftlint",
            "else",
            "  echo \"SwiftLint not installed, download from https://github.com/realm/SwiftLint\"",
            "fi",
            "",
          ],
        },
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "BUNDLE_LOADER": "$(TEST_HOST)",
