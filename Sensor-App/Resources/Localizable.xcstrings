          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Performance metrics are delivered once per day from real device usage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las métricas de rendimiento se entregan una vez al día a partir del uso en dispositivos reales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
