      "comment" : "A description of the performance metrics that are delivered by the app.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metriky výkonu jsou doručovány jednou denně ze skutečného používání zařízení."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
