    "Record sensor sessions with timestamps and review them anytime" : {
      "comment" : "A description of the new recording and review feature.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaznamenávejte relace senzorů s časovými razítky a kdykoli si je prohlížejte"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorsitzungen mit Zeitstempeln aufzeichnen und sie jederzeit einsehen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grabar sesiones de sensores con marcas de tiempo y revisarlas en cualquier momento"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Enregistrez des sessions de capteurs avec horodatage et consultez-les à tout moment"
