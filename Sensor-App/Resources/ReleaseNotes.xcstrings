        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイムスタンプ付きでセンサーセッションを記録し、いつでも確認できます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "타임스탬프가 포함된 센서 세션을 기록하고 언제든지 확인하세요"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gravar sessões de sensores com marcas temporais e revê-las a qualquer momento"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "记录带时间戳的传感器会话，随时查看"
          }
        }
      }
    },
    "Recorded sensor sessions can be synchronised across devices via iCloud" : {
      "comment" : "A description of the new iCloud synchronization feature.",
