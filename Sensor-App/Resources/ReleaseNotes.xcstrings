    "Each recording starts with a clean slate, so it only contains data captured after you tap Record" : {
      "comment" : "A description of the recording feature.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každý záznam začíná od nuly, takže obsahuje pouze data zachycená po klepnutí na „Zaznamenat“"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Aufzeichnung beginnt von vorn und enthält nur Daten, die nach dem Tippen auf „Aufzeichnen“ erfasst wurden"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each recording starts with a clean slate, so it only contains data captured after you tap Record"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada grabación empieza desde cero, por lo que solo contiene los datos captados después de tocar Grabar"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque enregistrement repart de zéro et ne contient que les données capturées une fois que vous avez touché « Enregistrer »"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni registrazione parte da zero e contiene solo i dati acquisiti dopo aver toccato Registra"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記録は毎回まっさらな状態から始まるため、「記録」をタップした後に取得したデータのみが含まれます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 기록은 처음부터 새로 시작되므로 ‘기록’을 탭한 후 수집된 데이터만 포함됩니다"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada gravação começa do zero e contém apenas os dados captados depois de tocar em «Gravar»"
