    "Pause and Delete are disabled during a recording to prevent gaps or lost data" : {
      "comment" : "A note that pausing or deleting a recording is disabled during a recording.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tlačítka „Pozastavit“ a „Smazat“ jsou během záznamu nedostupná, aby nevznikaly mezery nebo nedošlo ke ztrátě dat"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Pause“ und „Löschen“ sind während einer Aufzeichnung deaktiviert, um Lücken oder Datenverlust zu vermeiden"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pause and Delete are disabled during a recording to prevent gaps or lost data"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa y Eliminar están deshabilitados durante una grabación para evitar lagunas o pérdida de datos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les boutons « Pause » et « Supprimer » sont désactivés pendant un enregistrement afin d’éviter les interruptions ou les pertes de données"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
